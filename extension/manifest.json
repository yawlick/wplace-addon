{
  "manifest_version": 3,
  "name": "Wplace Auto Color",
  "description": "Выбирает цвет шаблона перед каждым пикселем при ручном рисовании.",
  "version": "1.12.0",
  "permissions": ["storage"],
  "host_permissions": ["https://wplace.live/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wplace Auto Color"
  },
  "content_scripts": [
    {
      "matches": ["https://wplace.live/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://wplace.live/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
